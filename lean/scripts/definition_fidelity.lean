run_cmd do
  let env ← getEnv
  let mut total := 0
  for s in frozenShortNames do
    let hits := env.constants.fold (init := (#[] : Array (Name × ConstantInfo))) fun acc n ci =>
      let t := n.toString
      if (t == s || t.endsWith ("." ++ s) || t.startsWith (s ++ ".") || (t.splitOn ("." ++ s ++ ".")).length > 1)
         && !n.isInternal && (t.startsWith "DiophCompression." || t.startsWith "MPUP.") then acc.push (n, ci) else acc
    if hits.isEmpty then logInfo m!"DEFMISSING {s}"
    for (n, ci) in hits.qsort (fun a b => a.1.toString < b.1.toString) do
      let kind := match ci with
        | .defnInfo _ => "def" | .thmInfo _ => "theorem" | .opaqueInfo _ => "opaque"
        | .axiomInfo _ => "axiom" | .inductInfo _ => "inductive" | .ctorInfo _ => "ctor"
        | .recInfo _ => "rec" | .quotInfo _ => "quot"
      let val? := match ci with
        | .defnInfo d => some d.value | .thmInfo t => some t.value | .opaqueInfo o => some o.value | _ => none
      let (tyS, valS) ← liftTermElabM <| withOptions (fun o => ((o.setBool `pp.explicit true).setBool `pp.universes true).setBool `pp.proofs true) do
        let tyS := toString (← ppExpr ci.type)
        let valS ← match val? with
          | some v => do pure (toString (← ppExpr v))
          | none => pure "<novalue>"
        pure (tyS, valS)
      total := total + 1
      logInfo m!"DEFBEGIN {n} short={s} kind={kind}\nTYPE {tyS}\nVALUE {valS}\nDEFEND {n}"
  logInfo m!"DEFTOTAL {total} shortnames={frozenShortNames.length}"
