def DiophCompression.ResearchUpgrade.CommonSlopeIntNF : {n m : ℕ} → ((Fin n → ℤ) → Fin m → ℤ) → Prop :=
fun {n m} f => ∃ M B, 1 ≤ M ∧ ∀ (a t : Fin n → ℤ), f (a + ↑M • t) = f a + B.mulVec t
@@SEP@@ GlobalQuadratic
def DiophCompression.ResearchUpgrade.GlobalQuadratic : {n : ℕ} → ((Fin n → ℤ) → ℤ) → Prop :=
fun {n} f => ∃ q, ∀ (x : Fin n → ℤ), ↑(f x) = q.eval (castQ x)
@@SEP@@ ParityAffineNF
def DiophCompression.ResearchUpgrade.ParityAffineNF : {n : ℕ} → ((Fin n → ℤ) → ℤ) → Prop :=
fun {n} F =>
  ∃ p q c c',
    (∀ (i : Fin n), 2 ∣ p i - q i) ∧
      (∃ i, ¬2 ∣ p i) ∧
        ¬2 ∣ c - c' ∧
          ∀ (x : Fin n → ℤ), (2 ∣ p ⬝ᵥ x + c → 2 * F x = p ⬝ᵥ x + c) ∧ (¬2 ∣ p ⬝ᵥ x + c → 2 * F x = q ⬝ᵥ x + c')
