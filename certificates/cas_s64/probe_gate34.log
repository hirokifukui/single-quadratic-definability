def DiophCompression.ResearchUpgrade.TCERBridge.TernaryCosetEventualRepresentation : Prop :=
∀ (S : Matrix (Fin 3) (Fin 3) ℤ) (d : ℕ) (ρ : Fin 3 → ℤ),
  S.IsSymm →
    (∀ (y : Fin 3 → ℤ), y ≠ 0 → 0 < TCERBridge.QS S y) →
      0 < d →
        ∃ bad E,
          (∀ p ∈ bad, Nat.Prime p) ∧
            (∀ e ∈ E, 0 < e) ∧
              ∀ (b : ℕ → ℕ),
                ∃ N₀,
                  ∀ (N : ℤ),
                    N₀ ≤ N →
                      TCERBridge.LocalPrimRep S d ρ N →
                        (∀ p ∈ bad, ¬↑p ^ (b p + 1) ∣ N) →
                          (∀ e ∈ E, ¬∃ q, ↑N = ↑e * q ^ 2) → ∃ x, TCERBridge.QS S (ρ + ↑d • x) = N
@@SEP@@ LocalPrimRep
def DiophCompression.ResearchUpgrade.TCERBridge.LocalPrimRep : Matrix (Fin 3) (Fin 3) ℤ → ℕ → (Fin 3 → ℤ) → ℤ → Prop :=
fun S d ρ N =>
  ∀ (p : ℕ),
    Nat.Prime p → ∀ (e : ℕ), ∃ x, ↑p ^ e ∣ TCERBridge.QS S (ρ + ↑d • x) - N ∧ ¬∀ (i : Fin 3), ↑p ∣ (ρ + ↑d • x) i
