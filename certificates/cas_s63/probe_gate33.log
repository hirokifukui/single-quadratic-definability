      DiophCompression.RepresentsZZ P (DiophCompression.graphVecZZ f) ∧
        ∀ (v : Fin (n + m) → ℤ) (y y' : Fin r → ℤ),
          DiophCompression.evalAtZZ P v y = 0 → DiophCompression.evalAtZZ P v y' = 0 → y = y'
